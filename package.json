{
  "name": "prism-accessibility",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "postbuild": "node scripts/normalize-static-segments.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/pcci.test.ts tests/engine.test.ts tests/figure.test.ts",
    "test:regression": "tsx --test tests/pcci-regression.test.ts",
    "benchmark:figures": "tsx scripts/compare-figures.ts",
    "benchmark:stage1": "tsx scripts/stage1-colors.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.json README.md",
    "format:check": "prettier --check src scripts tests *.ts *.json README.md",
    "prepare-assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
